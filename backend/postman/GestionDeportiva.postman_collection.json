    {
      "name": "Deportistas",
      "description": "CRUD de deportistas. Requiere token Bearer.",
      "item": [
        {
          "name": "Listar",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/deportistas",
              "host": ["{{baseUrl}}"],
              "path": ["deportistas"]
            },
            "description": "Lista paginada. El test guarda el primer ID en 'deportistaId'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const first = json.data && json.data[0];",
                  "if (first && first.id) {",
                  "  pm.collectionVariables.set('deportistaId', String(first.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "nombre", "value": "Juan", "type": "text" },
                { "key": "apellido", "value": "Pérez", "type": "text" },
                { "key": "fecha_nacimiento", "value": "2000-05-15", "type": "text" },
                { "key": "modalidad_id", "value": "{{modalidadId}}", "type": "text" },
                { "key": "foto", "type": "file", "src": [], "description": "Opcional: jpeg/png/jpg/webp, máx 2MB" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/deportistas",
              "host": ["{{baseUrl}}"],
              "path": ["deportistas"]
            },
            "description": "Crea un deportista. 'modalidad_id' debe existir."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.data && json.data.id) {",
                  "    pm.collectionVariables.set('deportistaId', String(json.data.id));",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/deportistas/{{deportistaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["deportistas", "{{deportistaId}}"]
            }
          }
        },
        {
          "name": "Actualizar (con foto opcional)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "_method", "value": "PUT", "type": "text" },
                { "key": "nombre", "value": "Juan Carlos", "type": "text" },
                { "key": "apellido", "value": "Pérez", "type": "text" },
                { "key": "fecha_nacimiento", "value": "2000-05-15", "type": "text" },
                { "key": "modalidad_id", "value": "{{modalidadId}}", "type": "text" },
                { "key": "foto", "type": "file", "src": [], "description": "Opcional" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/deportistas/{{deportistaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["deportistas", "{{deportistaId}}"]
            },
            "description": "IMPORTANTE: se usa POST con _method=PUT porque PHP no parsea multipart/form-data en PUT directamente."
          }
        },
        {
          "name": "Eliminar",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{token}}", "type": "string" }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/deportistas/{{deportistaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["deportistas", "{{deportistaId}}"]
            }
          }
        }
      ]
